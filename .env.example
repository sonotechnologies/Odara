# Neon connection string (use the pooled one on Vercel). Locally any Postgres 15+ works.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/odara
# Signs session cookies (studio login, client device, OTP). Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string
# Public origin, used in WhatsApp links and calendar invites.
APP_URL=http://localhost:3000
# Studio demo login. Shown on /studio/login on purpose, it is a portfolio demo.
STUDIO_DEMO_EMAIL=owner@odara.demo
STUDIO_DEMO_PASSWORD=odara-demo
# Pexels API key, only needed to pick photos (npm run photos:pick) or for live fallback search.
PEXELS_API_KEY=
